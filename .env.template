# Copy this template to .env and fill in values.
# Only uncomment a variable if you also plan to set a value.
# Do NOT commit your .env to Git, it contains secrets.

# REQUIRED: Discord bot token
DISCORD_TOKEN=your_bot_token_here

# Optional: Base URL for your API (must end with a slash '/' so paths can be joined correctly)
# API_BASE=https://example.com/api/

# Optional: Backend token for API authentication
# BACKEND_TOKEN=supersecrettoken

# Optional: Discord guild ID for guild-specific commands
# GUILD_ID=123456789012345678

# Optional: If true, register commands in the guild specified by GUILD_ID. Defaults to false (registers globally)
# REGISTER_GUILD_COMMANDS=true

# Optional: Cope emoji ID for reactions
# COPE_NN_ID=987654321012345678

# Optional: Channel ID for member count updates
# MEMBER_COUNT_ID=111111111012345678

# Optional: Channel ID for download count updates
# DOWNLOAD_COUNT_ID=222222222012345678

# Optional: UptimeRobot URL for uptime monitoring
# UPTIME_URL=https://uptimerobot.com/monitor/abcdef123456
